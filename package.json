{
  "author": "Cuyler Stuwe",
  "name": "minimal-chrome-extension-boilerplate",
  "longName": "Minimal Chrome Extension Boilerplate",
  "version": "2.0.0",
  "description": "",
  "license": "Private",
  "scripts": {
    "build:base": "ts-node --project tsconfig.json --esm scripts/build.ts",
    "build:local-dev": "npm run build:base -- --env development --build-env development --deploy-mode local-dev",
    "build:updated-deploy": "npm run build:base -- --env production --build-env production --deploy-mode updated-deploy",
    "build:initial-deploy": "npm run build:base -- --env production --build-env production --deploy-mode initial-deploy",
    "test": "jest",
    "e2e": "ts-node e2e/setup/init.ts",
    "watch:barrel": "nodemon --watch \"src/background/listeners/functions/**\" --ext \"ts\" --ignore \"src/background/listeners/functions/**.test.ts\" --exec \"ts-node webpack-helpers/makeBarrel.ts\""
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.14.7",
    "@babel/preset-react": "^7.24.1",
    "@babel/preset-typescript": "^7.24.1",
    "@types/chai": "^4.3.16",
    "@types/chrome": "*",
    "@types/jest": "*",
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^7.10.0",
    "@typescript-eslint/parser": "^7.10.0",
    "babel-eslint": "^10.1.0",
    "chai": "^5.1.1",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-no-relative-import-paths": "^1.5.4",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^27.0.6",
    "nodemon": "^3.1.3",
    "prettier": "^3.2.5",
    "puppeteer": "^22.10.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-adblocker": "^2.13.6",
    "puppeteer-extra-plugin-recaptcha": "^3.6.8",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "zod": "^3.23.8"
  }
}
